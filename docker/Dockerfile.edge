FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml README.md /app/
COPY edge /app/edge
COPY configs /app/configs
COPY models /app/models

ENV PYTHONPATH=/app
RUN pip install --no-cache-dir .

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "edge.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
